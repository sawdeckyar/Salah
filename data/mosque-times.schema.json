{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://salah.app/schemas/mosque-times.schema.json",
  "title": "Salah Mosque Times Registry",
  "description": "Community-maintained registry of mosque-specific iqama (jamā‘ah) and Jumu‘ah times, keyed where possible to OpenStreetMap features. This is the data that is otherwise scattered across individual mosque websites.",
  "type": "object",
  "required": ["version", "entries"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/definitions/registryEntry" }
    }
  },
  "definitions": {
    "coordinates": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "hhmm": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "description": "Local wall-clock time, 24-hour HH:mm."
    },
    "contact": {
      "type": "object",
      "properties": {
        "phone": { "type": "string" },
        "website": { "type": "string", "format": "uri" },
        "email": { "type": "string", "format": "email" }
      }
    },
    "jumuahService": {
      "type": "object",
      "required": ["khutbahTime"],
      "properties": {
        "label": { "type": "string" },
        "khutbahTime": { "$ref": "#/definitions/hhmm" },
        "iqamaTime": { "$ref": "#/definitions/hhmm" },
        "language": { "type": "string" }
      }
    },
    "mosqueTimes": {
      "type": "object",
      "properties": {
        "iqama": {
          "type": "object",
          "properties": {
            "fajr": { "$ref": "#/definitions/hhmm" },
            "dhuhr": { "$ref": "#/definitions/hhmm" },
            "asr": { "$ref": "#/definitions/hhmm" },
            "maghrib": { "$ref": "#/definitions/hhmm" },
            "isha": { "$ref": "#/definitions/hhmm" }
          },
          "additionalProperties": false
        },
        "jumuah": {
          "type": "array",
          "items": { "$ref": "#/definitions/jumuahService" }
        },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "contributor": { "type": "string" },
        "verified": { "type": "boolean" }
      }
    },
    "registryEntry": {
      "type": "object",
      "required": ["id", "times"],
      "properties": {
        "id": { "type": "string" },
        "osmId": {
          "type": "string",
          "pattern": "^(node|way|relation)/[0-9]+$",
          "description": "OSM feature this entry annotates. Omit for mosques OSM does not yet have."
        },
        "name": { "type": "string" },
        "location": { "$ref": "#/definitions/coordinates" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "country": { "type": "string" },
        "contact": { "$ref": "#/definitions/contact" },
        "times": { "$ref": "#/definitions/mosqueTimes" }
      },
      "allOf": [
        {
          "description": "Standalone entries (no osmId) must carry their own name + location.",
          "if": { "not": { "required": ["osmId"] } },
          "then": { "required": ["name", "location"] }
        }
      ]
    }
  }
}
